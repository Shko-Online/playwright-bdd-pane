{
  "name": "playwright-bdd-pane",
  "version": "0.0.0-semantic-release",
  "private": true,
  "description": "Azure DevOps extension: publish playwright-bdd reports and view them in a build results tab.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tasks/PublishPlaywrightBddReport/tsconfig.json",
    "icons": "node scripts/make-icons.mjs",
    "fixtures": "node scripts/build.mjs --dev && node scripts/make-fixtures.mjs",
    "dev": "node scripts/build.mjs --dev && node scripts/dev-server.mjs",
    "storybook": "node scripts/build.mjs --web-only && storybook dev -p 6006",
    "build-storybook": "node scripts/build.mjs --web-only && storybook build -o build/storybook",
    "package": "node scripts/package.mjs",
    "package:dev": "node scripts/package.mjs --dev",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.10",
    "@storybook/html": "^10.6.5",
    "@storybook/html-vite": "^10.6.5",
    "azure-devops-extension-api": "^5.279.1",
    "azure-devops-extension-sdk": "^4.2.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "playwright-core": "1.65.0",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.5",
    "tfx-cli": "^0.24.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.14"
  }
}
